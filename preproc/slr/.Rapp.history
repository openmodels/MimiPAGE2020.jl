world <- sapply(strsplit("when in the course of human events it becomes necessary", "")[[1]], utf8ToInt)#
#
fsm <- list(c(97, 1, 1))#
organism <- list(location=1, energy=5, fsm=fsm, state=1, tick=function(self, env) {#
  currstate <- self$fsm[[self$state]]#
  if (env[2] == currstate[1])#
    nextstate <- currstate[2]#
  else#
    nextstate <- currstate[3]#
  c(self$fsm[[nextstate]][1], nextstate)#
})#
#
fail.loss <- 0.15#
succ.gain <- 1.15#
#
record.org <- data.frame()#
organisms = list(organism)#
for (time in 1:1000) {#
  for (oo in 1:length(organisms)) {#
    org <- organisms[[oo]]#
    leftloc <- (org$location - 2) %% length(world) + 1#
    rightloc <- org$location %% length(world) + 1#
    env <- c(world[c(leftloc, org$location)])#
    organisms[[oo]]$location <- rightloc#
    predstate <- org$tick(org, env)#
    organisms[[oo]]$state <- predstate[2]#
    energychange <- succ.gain / (abs(world[rightloc] - predstate[1]) + 1) - fail.loss#
    organisms[[oo]]$energy <- org$energy + energychange#
    if (organisms[[oo]]$energy > 10) {#
      organisms[[length(organisms) + 1]] <- list(location=leftloc,#
        energy=5, fsm=fsm, state=1, tick=org$tick)#
      organisms[[oo]]$energy <- org$energy - 5#
    } else if (organisms[[oo]]$energy < 0) {#
      organisms[[oo]] <- NA#
    }#
  }#
  organisms <- organisms[!is.na(organisms)]#
  if (length(organisms) == 0)#
    organisms <- list(organism)#
  record.org <- rbind(record.org, data.frame(time, loc=sapply(organisms, function(org) org$location),#
                                             energy=sapply(organisms, function(org) org$energy)))
}#
#
ggplot(record.org, aes(loc, time)) +#
  geom_point(data=record.org, aes(colour=energy))
