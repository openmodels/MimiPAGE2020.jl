fail.loss <- 0.75#
succ.gain <- 1#
#
record.env <- data.frame()#
record.org <- data.frame()#
organisms = list(organism)#
for (time in 1:1000) {#
  for (oo in 1:length(organisms)) {#
    org <- organisms[[oo]]#
    leftloc <- (org$location - 2) %% length(world) + 1#
    rightloc <- org$location %% length(world) + 1#
    env <- c(world[c(leftloc, org$location)])#
    pred <- org$tick(oo, env)#
    if (world[rightloc] == pred) {#
      organisms[[oo]]$energy <- org$energy + succ.gain#
      world[rightloc] <- '#'#
      if (organisms[[oo]]$energy > 10) {#
        organisms[[length(organisms) + 1]] <- list(location=sample(c(leftloc, rightloc), 1),#
          energy=5, tick=org$tick)#
        organisms[[oo]]$energy <- org$energy - 5#
      }  #
    } else {#
      organisms[[oo]]$energy <- org$energy - fail.loss#
      if (organisms[[oo]]$energy < 0)#
        organisms[[oo]] <- NA#
    }#
  }#
  organisms <- organisms[!is.na(organisms)]#
  if (length(organisms) == 0)#
    organisms <- list(organism)#
  record.env <- rbind(record.env, data.frame(time, loc=1:length(world), full=world == text, empty=world == '#'))#
  record.org <- rbind(record.org, data.frame(time, loc=sapply(organisms, function(org) org$location),#
                                             energy=sapply(organisms, function(org) org$energy)))#
  ## Relenish 50% of the cells#
  replenish <- (1:length(world))[runif(length(world)) < .5]#
  world[replenish] <- text[replenish]#
}#
#
