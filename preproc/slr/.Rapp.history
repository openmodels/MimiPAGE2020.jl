mutate <- function(fsm) {#
  ## Choose a random gene#
  chosen <- sample(length(fsm), 1)#
  modify <- sample(3, 1)#
  if (modify == 1) {#
    fsm[[chosen]][1] <- sample(utf8ToInt('a'):utf8ToInt('z'), 1)#
  } else {#
    ## Change it to a random location, possibly a new location#
    nextstate <- sample(length(fsm) + 1, 1)#
    fsm[[chosen]][modify] <- nextstate#
    if (nextstate > length(fsm))#
      fsm[[nextstate]] <- c(sample(utf8ToInt('a'):utf8ToInt('z'), 1), 1, 1)#
  }#
  fsm#
}#
#
testrun <- function(org) {#
  text <- c()#
  for (ii in 1:length(world)) {#
    leftloc <- (ii - 2) %% length(world) + 1#
    env <- c(world[c(leftloc, ii)])#
    predstate <- org$tick(org, env)#
    org$state <- predstate[2]#
    text <- c(text, predstate[1])#
  }#
#
  text#
}
get.entropy.rate <- function(text) {#
    pp <- table(paste(text[-length(text)], text[-1])) / (length(text) - 1)#
    -sum(pp * log2(pp))#
  }
myorg <- list(fsm=myfsm, state=1, tick=organism$tick)
bestorg <- organism#
bestscore <- 0#
#
for (ii in 1:1000) {#
  myfsm <- bestorg$fsm#
  for (mm in 1:3)#
    myfsm <- mutate(myfsm)#
  org <- list(fsm=myfsm, state=1, tick=organism$tick)#
  text <- testrun(org)#
  score <- get.entropy.rate(text)#
  if (score > bestscore) {#
    print("Improved!")#
    bestscore <- score#
    bestorg <- org#
  }#
}
bestorg <- organism#
bestscore <- sum(rep('a', length(world)) == world)#
#
record.org <- data.frame()#
organisms = list(organism)#
for (time in 1:1000) {#
  for (oo in 1:length(organisms)) {#
    org <- organisms[[oo]]#
    leftloc <- (org$location - 2) %% length(world) + 1#
    rightloc <- org$location %% length(world) + 1#
    env <- c(world[c(leftloc, org$location)])#
    organisms[[oo]]$location <- rightloc#
    predstate <- org$tick(org, env)#
    organisms[[oo]]$state <- predstate[2]#
    energychange <- succ.gain / (abs(world[rightloc] - predstate[1]) + 1) - fail.loss#
    organisms[[oo]]$energy <- org$energy + energychange#
    if (organisms[[oo]]$energy > 10) {#
      print("B")#
      organisms[[length(organisms) + 1]] <- list(location=leftloc,#
        energy=5, fsm=mutate(fsm), state=1, tick=org$tick)#
      organisms[[oo]]$energy <- org$energy - 5#
    } else if (organisms[[oo]]$energy < 0) {#
      organisms[[oo]] <- NA#
    }#
  }#
  organisms <- organisms[!is.na(organisms)]#
  if (length(organisms) == 0) {#
    print("A")#
    org <- list(location=1, energy=5, fsm=mutate(bestorg$fsm), state=1, tick=bestorg$tick)#
    text <- testrun(org)#
    score <- sum(text == world)#
    if (score > bestscore) {#
      bestorg <- org#
      bestscore <- score#
    }#
    organisms <- list(bestorg)#
  }#
  record.org <- rbind(record.org, data.frame(time, loc=sapply(organisms, function(org) org$location),#
                                             energy=sapply(organisms, function(org) org$energy)))#
}#
